{
  "name": "pellicule",
  "version": "0.1.0",
  "description": "Deterministic video rendering with Vue",
  "type": "module",
  "main": "./src/index.js",
  "bin": {
    "pellicule": "./bin/cli.js"
  },
  "exports": {
    ".": "./src/index.js",
    "./render": "./src/render.js",
    "./nuxt": "./src/nuxt/module.js",
    "./quasar": "./src/quasar/index.js"
  },
  "keywords": [
    "vue",
    "video",
    "rendering",
    "animation",
    "frames",
    "programmatic-video"
  ],
  "author": "Kelvin Omereshone <kelvin@sailscasts.com>",
  "license": "MIT",
  "homepage": "https://docs.sailscasts.com/pellicule",
  "repository": {
    "type": "git",
    "url": "https://github.com/sailscastshq/pellicule"
  },
  "dependencies": {
    "@vitejs/plugin-vue": "^5.0.0",
    "playwright": "^1.40.0",
    "vite": "^5.0.0"
  },
  "peerDependencies": {
    "@nuxt/kit": "^3.0.0",
    "@rsbuild/core": "^1.0.0",
    "@rsbuild/plugin-vue": "^1.0.0",
    "vue": "^3.0.0"
  },
  "peerDependenciesMeta": {
    "@rsbuild/core": {
      "optional": true
    },
    "@rsbuild/plugin-vue": {
      "optional": true
    },
    "@nuxt/kit": {
      "optional": true
    }
  },
  "devDependencies": {
    "@nuxt/kit": "^4.3.0"
  }
}
